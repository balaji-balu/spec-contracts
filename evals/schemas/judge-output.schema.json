{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eval judge output",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "rubric", "criteria", "verdict"],
  "properties": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {"type": "string"},
        "id": {"type": "string"},
        "version": {"type": "integer"}
      }
    },
    "rubric": {"type": "string", "pattern": "^[a-z-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "evidence", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^([A-Z]{2}-[0-9]+|CONST-ART-[0-9]+)$"},
          "score": {"type": "integer", "minimum": 1, "maximum": 5},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "quote"],
              "properties": {
                "ref": {"type": "string", "description": "ID (REQ-002, AC-002.2, GOAL-1…) or file section"},
                "quote": {"type": "string", "maxLength": 300}
              }
            }
          },
          "rationale": {"type": "string", "maxLength": 600},
          "defect": {"type": "string", "maxLength": 300, "description": "Required when score <= 3: the specific defect to fix"}
        },
        "allOf": [{"if": {"properties": {"score": {"maximum": 3}}}, "then": {"required": ["defect"]}}]
      }
    },
    "verdict": {"enum": ["pass", "revise"]},
    "injection_suspected": {"type": "boolean"}
  }
}
