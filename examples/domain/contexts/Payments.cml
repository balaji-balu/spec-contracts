BoundedContext Payments implements PaymentProcessing {
  type = FEATURE
  domainVisionStatement = "Captures and returns money, and never needs to understand Orders."
  responsibilities = "Payments", "Refunds"

  Aggregate Refunds {
    Entity Refund {
      aggregateRoot
      - RefundId id
      - OrderReference orderReference
      - PaymentMethod paymentMethod
      int amountMinor
      String status
      int attempts
    }
    ValueObject RefundId {
      String value key
    }
    ValueObject OrderReference {
      String value key
    }
    ValueObject PaymentMethod {
      String providerToken
    }
    DomainEvent RefundIssued {
      - RefundId refundId
      - OrderReference orderReference
      Date issuedAt
    }
    DomainEvent RefundFailed {
      - RefundId refundId
      String reason
    }
  }
}
