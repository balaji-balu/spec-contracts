BoundedContext Ordering implements OrderManagement {
  type = FEATURE
  domainVisionStatement = "Owns the life of an Order from placement to Shipment or Cancellation."
  responsibilities = "Orders", "Cancellation"

  Aggregate Orders {
    Entity Order {
      aggregateRoot
      - OrderId id
      String status
      Date shippedAt
    }
    ValueObject OrderId {
      String value key
    }
    DomainEvent OrderCancelled {
      - OrderId orderId
      Date cancelledAt
    }
  }
}
