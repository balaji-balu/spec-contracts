import "./contexts/Ordering.cml"
import "./contexts/Payments.cml"

Domain Commerce {
  domainVisionStatement = "Sell goods online and settle the money for them correctly."

  Subdomain OrderManagement {
    type = CORE_DOMAIN
    domainVisionStatement = "Take, change and cancel Customer Orders until they ship."
  }

  Subdomain PaymentProcessing {
    type = SUPPORTING_DOMAIN
    domainVisionStatement = "Capture and return money through external payment providers."
  }
}

ContextMap CommerceMap {
  type = SYSTEM_LANDSCAPE
  state = TO_BE

  contains Ordering, Payments

  // Ordering publishes order facts; Payments translates them into its own model.
  Ordering [U,OHS,PL]->[D,ACL] Payments {
    implementationTechnology = "Domain events"
  }
}
