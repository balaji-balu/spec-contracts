{
  "name": "step-runner",
  "version": "0.1.0",
  "description": "Runs one agent step in a clean workspace, pinned by pipeline.lock.yaml (M1: no reconciler yet; the suite runner builds on it).",
  "type": "module",
  "bin": {
    "run-step": "bin/run-step.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-force-exit test/*.test.ts",
    "lock": "node --import tsx src/lock-cli.ts",
    "demo": "node --import tsx src/demo.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "pi-spec-tools": "*",
    "spec-lint": "*",
    "tsx": "^4.19.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
